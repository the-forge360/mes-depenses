# Modèle des variables d'environnement de l'app « Mes dépenses ».
# Copier ce fichier en .env.local puis remplacer les valeurs.
# Ne jamais mettre de vraies valeurs dans ce fichier : il est publié sur GitHub.
#
# Toutes les variables préfixées par VITE_ sont intégrées au code envoyé
# au navigateur : elles sont donc visibles par tout le monde.
# N'y mettre QUE des valeurs publiques.

# --- Supabase (base de données + comptes utilisateurs) ---
# Tableau de bord Supabase > Project Settings > API

# Adresse du projet Supabase (région Europe de l'Ouest)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIQUE (publishable) : sans danger dans l'app grâce à la RLS.
# Ne JAMAIS mettre ici la clé secrète (service role / secret key).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
